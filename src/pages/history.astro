---
import BaseLayout from "@/layouts/base-layout.astro";
//@ts-ignore
import GlobalHeroSection from "@/components/sections/global-hero-section.astro";
import ContactSection from "@/components/sections/contact-section.astro";
import HistoryContentSection from "@/components/sections/history-content-section.astro";
import { frontmatter } from "../content/history.md";
---

<BaseLayout
  metadata={{
    title: "History",
    description: "Sobre nosotros",
    ignoreTitleTemplate: true,
  }}
>
  <GlobalHeroSection img={frontmatter.heroImage} title={frontmatter.title} />
  <HistoryContentSection />
  <ContactSection />
</BaseLayout>
