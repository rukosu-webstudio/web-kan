---
import CollectionsSection from "@/components/sections/collections-section.astro";
import ContactSection from "@/components/sections/contact-section.astro";
import FeaturedProductsSection from "@/components/sections/featured-products-section.astro";
import HeroSection from "@/components/sections/hero-section.astro";
import TwoCollumnsSection from "@/components/sections/two-collumns-section.astro";
import { ROUTE } from "@/config/routes";
import BaseLayout from "@/layouts/base-layout.astro";
import { getAllProducts } from "@/services/product.service";

const allProducts = await getAllProducts();

const featuredProducts = allProducts.filter((p) => p.featured === true);
const women = allProducts.filter((p) => p.tag?.toLowerCase().includes("women")).slice(0, 4);
const men = allProducts.filter((p) => p.tag?.toLowerCase().includes("men")).slice(0, 4);
---

<BaseLayout
  metadata={{
    title: "Home",
    description: "Explora nuestra marca",
    ignoreTitleTemplate: true,
  }}
>
  <HeroSection />
  <FeaturedProductsSection products={featuredProducts} />
  <TwoCollumnsSection
    products={women}
    title="WOMEN"
    desc="EL ESTÁNDAR KAN AHORA SE EXTIENDE A LAS mujeres"
    cover="/default/women-banner.png"
    url={`${ROUTE.SHOP.path}?category=women`}
    slug="women"
  />
  <TwoCollumnsSection
    mode="2"
    products={men}
    title="MEN"
    desc="EL ESTÁNDAR KAN AHORA SE EXTIENDE A LOS HOMBRES"
    cover="/default/men-banner.png"
    url={`${ROUTE.SHOP.path}?category=men`}
    slug="men"
  />
  <CollectionsSection />
  <ContactSection />
</BaseLayout>
