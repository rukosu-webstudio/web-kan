---
import ProductHeaderInfo from "@/components/section-components/product-header-info.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getProductPrueba } from "@/services/product.service";

const productPrueba = await getProductPrueba();

if (!productPrueba) {
  return Astro.redirect("/404");
}

const product = productPrueba;
---

<BaseLayout
  metadata={{
    title: product.name,
    description: `Compra ${product.name} en nuestra tienda.`,
    ignoreTitleTemplate: true,
  }}
>
  <section class="w-full py-14 lg:py-20 flex justify-center mt-32">
    <div class="w-full max-wrapper flex flex-col">
      <div
        class="w-full grid grid-cols-[3fr_2fr] justify-between items-stretch gap-x-10 gap-y-3"
      >
        <div class="w-full border h-4"></div>
        <div class="w-full h-full">
          <div class="w-full h-full flex flex-col gap-6">
            <ProductHeaderInfo
              name={product.name}
              tag={product.tag}
              price={product.price}
            />
          </div>
        </div>
      </div>
    </div>
  </section>
