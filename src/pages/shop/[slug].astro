---
import WhatsappIcon from "@/components/icons/whatsapp-icon.astro";
import ProductGallery from "@/components/section-components/product-gallery.astro";
import ProductHeaderInfo from "@/components/section-components/product-header-info.astro";
import { BUSINESS_CONFIG } from "@/config/business";
import BaseLayout from "@/layouts/base-layout.astro";
import { formatPrice } from "@/lib/utils";
import { getProductBySlug } from "@/services/product.service";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const product = await getProductBySlug(slug);

if (!product) {
  return Astro.redirect("/404");
}

// Image paths are already cleaned in the service
const cover = product.img;
const gallery = product.gallery || [];
---

<BaseLayout
  metadata={{
    title: product.name,
    description: `Compra ${product.name} en nuestra tienda.`,
    ignoreTitleTemplate: true,
  }}
>
  <section
    class="w-full py-14 lg:py-20 flex flex-col justify-center pt-28 lg:mt-32"
  >
    <div class="w-full max-wrapper flex flex-col gap-20">
      <div class="w-full flex flex-col gap-20">
        <div class="w-full flex justify-center items-center lg:hidden">
          <ProductHeaderInfo
            class="lg:hidden max-w-[560px]"
            name={product.name}
            tag={product.tag}
            price={product.price}
          />
        </div>

        <div
          class="w-full grid grid-cols-1 lg:grid-cols-[3fr_2fr] justify-between items-start gap-x-10 gap-y-10"
        >
          <div class="w-full min-w-0 overflow-hidden">
            <ProductGallery
              cover={cover || ""}
              gallery={gallery}
              name={product.name}
            />
          </div>
          <div class="w-full h-full flex justify-center items-center">
            <div class="w-full h-full flex flex-col gap-6 max-w-[560px]">
              <ProductHeaderInfo
                class="max-lg:hidden"
                name={product.name}
                tag={product.tag}
                price={product.price}
              />
              {product.color && (
                  <div class="w-full flex flex-col gap-1 uppercase">
                    <p class="text-sm font-light">COLOR:</p>
                    <p class="font-bold">{product.color}</p>
                  </div>
                )}
              <div class="w-full flex flex-col gap-1 uppercase">
                <p class="text-sm font-light">TALLAS:</p>
                <div
                  class="w-full flex justify-center items-center gap-2.5 font-mozilla font-light"
                >
                  {product.size?.map((s) => (
                      // biome-ignore lint/correctness/useJsxKeyInIterable: Astro does not use key prop
                      <button
                        class="size-button w-full px-4 border text-center hover:border-black transition-all duration-200 cursor-pointer active:opacity-50"
                        data-size={s}
                        type="button"
                      >
                        {s}
                      </button>
                    ))}
                </div>
              </div>

              {product.description && (
                  <div class="w-full flex flex-col gap-1 uppercase">
                    <p class="text-sm font-light">Descripción:</p>
                    <div class="w-full max-w-full">
                      <div
                        class="markdawn-content w-full prose prose-neutral max-w-none font-inter"
                        set:html={product.description}
                      />
                    </div>
                  </div>
                )}

              <div class="w-full flex flex-col justify-end pt-10">
                <a
                  id="buy-now-button"
                  class="flex justify-center items-center gap-5 px-6 py-2.5 bg-black text-white text-xl"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-name={product.name}
                  data-price={formatPrice(product.price)}
                  data-category={product.tag || product.category || ""}
                  data-whatsapp={`${BUSINESS_CONFIG.whatsapp.ext}${BUSINESS_CONFIG.whatsapp.number}`}
                >
                  <span> <WhatsappIcon /> </span>
                  <span>COMPRAR AHORA</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      {product.moreDetails?.length && product.moreDetails?.length > 0 && (
          <div class="w-full flex flex-col gap-10 justify-center items-center">
            <div class="size-20 aspect-square">
              <img
                class="h-full object-cover"
                src="/images/b-snake.png"
                alt=""
                width={80}
                height={80}
              />
            </div>
            <p class="w-full text-center text-2xl font-mozilla font-light uppercase">
              MáS SOBRE EL PRODUCTO
            </p>
            <div class="w-full flex">
              <div class="w-full grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 justify-center items-stretch gap-6">
                {product.moreDetails?.map((item) => (
                  // biome-ignore lint/correctness/useJsxKeyInIterable: Astro does not use key prop
                  <div class="w-full h-full flex flex-col gap-4 lg:gap-5 p-5 border-l-2 border-black">
                    <p class="w-full text-3xl font-light">{item.title}</p>
                    <p class="w-full text-lg font-light">{item.description}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
    </div>
  </section>
</BaseLayout>

<script>
  function setupBuyNow() {
    const sizeButtons = document.querySelectorAll(".size-button");
    const buyNowButton = document.getElementById(
      "buy-now-button"
    ) as HTMLAnchorElement;
    let selectedSize = "sin seleccionar";

    if (!buyNowButton) {
      return;
    }

    const name = buyNowButton.getAttribute("data-name");
    const price = buyNowButton.getAttribute("data-price");
    const category = buyNowButton.getAttribute("data-category");
    const whatsapp = buyNowButton.getAttribute("data-whatsapp");

    function updateBuyNowLink() {
      const url = window.location.href;
      const message = `¡Hola! Me interesa este producto:

          *${name}*
          *Precio:* ${price}
          *Talla:* ${selectedSize}
          *Categoría:* ${category}

          ¿Me podrían dar más información? ¡Muchas gracias! 
          ${url}`;

      const encodedMessage = encodeURIComponent(message);
      buyNowButton.setAttribute(
        "href",
        `https://wa.me/${whatsapp}?text=${encodedMessage}`
      );
    }

    for (const button of sizeButtons) {
      button.addEventListener("click", () => {
        // Remove active class from all
        for (const btn of sizeButtons) {
          btn.classList.remove("border-black", "bg-black", "text-white");
        }

        // Add active class to clicked
        button.classList.add("border-black", "bg-black", "text-white");

        selectedSize = button.getAttribute("data-size") || "sin seleccionar";
        updateBuyNowLink();
      });
    }

    // Initial call
    updateBuyNowLink();
  }

  // Run on initial load
  setupBuyNow();

  // Run on view transitions if enabled
  document.addEventListener("astro:after-swap", setupBuyNow);
</script>
