---
import WhatsappIcon from "@/components/icons/whatsapp-icon.astro";
import ProductHeaderInfo from "@/components/section-components/product-header-info.astro";
import ProductGallery from "@/components/section-components/product-gallery.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getProductPrueba } from "@/services/product.service";

const productPrueba = await getProductPrueba();

if (!productPrueba) {
  return Astro.redirect("/404");
}

const product = productPrueba;
---

<BaseLayout
  metadata={{
    title: product.name,
    description: `Compra ${product.name} en nuestra tienda.`,
    ignoreTitleTemplate: true,
  }}
>
  <section class="w-full py-14 lg:py-20 flex justify-center mt-32">
    <div class="w-full max-wrapper flex flex-col">
      <div
        class="w-full grid grid-cols-[3fr_2fr] justify-between items-stretch gap-x-10 gap-y-3"
      >
        <div class="w-full h-full flex flex-col border">
          <ProductGallery />
        </div>
        <div class="w-full h-full">
          <div class="w-full h-full flex flex-col gap-6">
            <ProductHeaderInfo
              name={product.name}
              tag={product.tag}
              price={product.price}
            />
            <div class="w-full flex flex-col gap-1 uppercase">
              <p class="text-sm font-light">COLOR:</p>
              <p class="font-bold">negro</p>
            </div>
            <div class="w-full flex flex-col gap-1 uppercase">
              <p class="text-sm font-light">TALLAS:</p>
              <div
                class="w-full flex justify-center items-center gap-2.5 font-mozilla font-light"
              >
                {
                  product.size.map((s) => (
                    <button class="w-full px-4 border text-center hover:border-black transition-all duration-200 cursor-pointer active:opacity-50">
                      {s}
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="w-full max-w-full">
              <div
                class="markdawn-content w-full prose prose-neutral max-w-none font-inter"
                set:html={product.description}
              />
            </div>
            <div class="w-full h-full flex flex-col justify-end pt-10">
              <a
                class="flex justify-center items-center gap-5 px-6 py-2.5 bg-black text-white text-xl"
                href=""
              >
                <span> <WhatsappIcon /> </span>
                <span>COMPRAR AHORA</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
