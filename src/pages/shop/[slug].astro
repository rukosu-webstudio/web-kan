---
import BaseLayout from "@/layouts/base-layout.astro";
import products from "@/data/products.json";
import { getProductPrueba } from "@/services/product.service";

const productPrueba = await getProductPrueba();
console.log(productPrueba);

const { slug } = Astro.params;
const product = products.find((p) => p.slug === slug);

if (!product) {
  return Astro.redirect("/404");
}
---

<BaseLayout
  metadata={{
    title: product.name,
    description: `Compra ${product.name} en nuestra tienda.`,
    ignoreTitleTemplate: true,
  }}
>
  <section class="w-full pt-40 pb-20 flex justify-center">
    <div class="max-wrapper w-full flex flex-col md:flex-row gap-10">
      <div class="w-full md:w-1/2 aspect-square">
        <img
          src={product.img}
          alt={product.name}
          class="w-full h-full object-cover rounded-xl"
        />
      </div>
      <div class="w-full md:w-1/2 flex flex-col gap-6">
        <h1 class="text-4xl font-bold uppercase">{product.name}</h1>
        <p class="text-2xl text-website-orange font-mozilla">
          ${product.price}
        </p>
        <p class="text-gray-600 uppercase">Categoría: {product.tag}</p>
        <div class="flex gap-4">
          {
            product.size.map((s) => (
              <span class="px-4 py-2 border border-black uppercase">{s}</span>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
