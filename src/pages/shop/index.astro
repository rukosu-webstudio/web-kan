    tag: "invierno",
    img: "/default/medias.png",
    imgHover: "/default/medias-hover.png",
    size: ["s", "m", "l", "xl", "xxl"],
  },
  {
    name: "leggings de compresión",
    slug: "leggings-de-compresion",
    price: 300,
    tag: "yoga",
    img: "/default/medias.png",
    imgHover: "/default/medias-hover.png",
    size: ["xs", "s", "m", "l"],
  },
  {
    name: "top deportivo sin costuras",
    slug: "top-deportivo-sin-costuras",
