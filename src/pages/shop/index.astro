---
import BaseLayout from "@/layouts/base-layout.astro";
//@ts-ignore
import GlobalHeroSection from "@/components/sections/global-hero-section.astro";
import ProductsSection from "@/components/sections/products-section";
import products from "@/data/products.json";
---

<BaseLayout
  metadata={{
    title: "Shop",
    description:
      "Encuentras productos y accesosrios deportivos de alta calidad",
    ignoreTitleTemplate: true,
  }}
>
  <GlobalHeroSection img="/default/shop-bg.png" title="TIENDA" />
  <ProductsSection products={products} client:load />
</BaseLayout>
