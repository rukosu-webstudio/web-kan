---
import BaseLayout from "@/layouts/base-layout.astro";
//@ts-ignore
import GlobalHeroSection from "@/components/sections/global-hero-section.astro";
import ProductsSection from "@/components/sections/products-section";
import { getAllProducts } from "@/services/product.service";
import { getProductFilterGroups } from "@/services/filter.service";
import { getCovers } from "@/services/cover.service";

const products = await getAllProducts();
const filterGroups = getProductFilterGroups(products);
const covers = await getCovers();
---

<BaseLayout
  metadata={{
    title: "Shop",
    description:
      "Encuentras productos y accesosrios deportivos de alta calidad",
    ignoreTitleTemplate: true,
  }}
>
  <GlobalHeroSection img={covers.shop} title="TIENDA" />
  <ProductsSection
    products={products}
    filterGroups={filterGroups}
    client:load
  />
</BaseLayout>
