---
const { img, title } = Astro.props;
---

<section class="relative w-full h-[50vh] flex justify-center">
  <img
    class="absolute inset-0 w-full h-full object-cover object-center z-0"
    src={img}
    alt=""
  >

  <div class="absolute inset-0 bg-black/60 z-10"></div>
  <div
    class="relative z-20 w-full max-wrapper flex flex-col justify-end pb-10 lg:pb-14"
  >
    <h1
      class="text-white text-4xl xl:text-5xl font-light font-montserrat uppercase"
    >
      {title}
    </h1>
  </div>
</section>
