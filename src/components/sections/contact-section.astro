---
import { BUSINESS_CONFIG } from "@/config/business";
import UpRightArrow from "../icons/up-right-arrow.astro";

const socialMediaLinks = [
  { title: "instagram", url: BUSINESS_CONFIG.social.instagram },
  { title: "facebook", url: BUSINESS_CONFIG.social.facebook },
  { title: "tiktok", url: BUSINESS_CONFIG.social.tiktok },
];

const contactMedia = [
  {
    title: "Teléfono",
    label: BUSINESS_CONFIG.phone.formatted,
    url: BUSINESS_CONFIG.phone.link,
  },
  {
    title: "Correo electrónico",
    label: BUSINESS_CONFIG.email.address,
    url: BUSINESS_CONFIG.email.link,
  },
];
---

<section
  id="contact"
  class="w-full py-14 lg:py-20 flex justify-center scroll-mt-10"
>
  <div class="w-full max-wrapper flex flex-col">
    <div class="w-full h-full flex flex-col justify-end items-center relative">
      <div class="w-full flex justify-center items-center py-14 z-30">
        <p
          class="text-center text-white text-3xl md:text-4xl xl:text-5xl font-montserrat uppercase"
        >
          contactanos
        </p>
      </div>
      <div class="w-full h-full bg-black/25 absolute inset-0 z-10"></div>
      <img
        class="w-full h-full object-cover absolute inset-0"
        src="/default/contact-bg.png"
        alt=""
      >
    </div>
    <div class="w-full py-10 px-2.5 grid grid-cols-1 md:grid-cols-2">
      <div class="w-full h-full flex flex-col justify-between gap-8">
        <p class="w-full text-2xl font-montserrat uppercase">REDES SOCIALES</p>
        <div
          class="w-full flex flex-col text-website-orange font-mozilla lg:text-lg uppercase nav-link-animated"
        >
          {socialMediaLinks.map((item) => {
              return (
                <a
                  href={item.url}
                  class="w-fit flex items-center gap-2.5"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <p>{item.title}</p>
                  <p>
                    <UpRightArrow class="size-6 text-website-orange" />
                  </p>
                </a>
              );
            })}
        </div>
        <div class="w-full flex flex-col lg:text-lg">
          {contactMedia.map((item) => {
              return (
                <a href={item.url} class="w-full flex items-center gap-1">
                  <p class="font-mozilla">{item.title}:</p>
                  <div class="font-extralight">{item.label}</div>
                </a>
              );
            })}
        </div>
      </div>
    </div>
  </div>
</section>
