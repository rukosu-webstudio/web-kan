---
import "swiper/css";
import "swiper/css/pagination";
import "swiper/css/navigation";

interface Props {
  images?: string[];
  title?: string;
}

const { title = "Nuestra Galería", images = [] } = Astro.props;

// Si no hay imágenes de momento, usamos las de public/gallery (soporta fotos y videos)
const slides =
  images.length > 0
    ? images
    : [
        "/gallery/Elite running.jpeg",
        "/gallery/Image-1.jpeg",
        "/gallery/imagen-2.jpeg",
        "/gallery/imagen-3.jpeg",
      ];

const YOUTUBE_SPLIT_REGEX = /[?#]/;
const YOUTUBE_QUERY_REGEX = /[&#]/;

const isVideo = (url: string) =>
  url.endsWith(".mp4") || url.endsWith(".webm") || url.endsWith(".ogg");

const isYoutube = (url: string) =>
  url.includes("youtube.com") || url.includes("youtu.be");

const getYoutubeEmbedUrl = (url: string, autoplay: boolean) => {
  if (!url) {
    return "";
  }
  let videoId = "";
  if (url.includes("youtu.be/")) {
    videoId = url.split("youtu.be/")[1]?.split(YOUTUBE_SPLIT_REGEX)[0] || "";
  } else if (url.includes("youtube.com/embed/")) {
    videoId =
      url.split("youtube.com/embed/")[1]?.split(YOUTUBE_SPLIT_REGEX)[0] || "";
  } else if (url.includes("v=")) {
    videoId = url.split("v=")[1]?.split(YOUTUBE_QUERY_REGEX)[0] || "";
  }
  return videoId
    ? `https://www.youtube.com/embed/${videoId}?autoplay=${autoplay ? 1 : 0}&mute=${autoplay ? 1 : 0}&loop=1&playlist=${videoId}`
    : "";
};
---

<section
  id="gallery"
  class="gallery-section w-full max-wrapper scroll-mt-12 overflow-hidden"
>
  <div class="w-full flex flex-col gap-8 pb-10">
    <h2 class="w-full text-2xl font-montserrat uppercase">Galeria</h2>
    <div class="w-full border border-[#DADADA]"></div>
  </div>

  <div class="swiper gallerySwiper px-4">
    <div class="swiper-wrapper py-4">
      {slides.map((slide, index) => (
        // biome-ignore lint/correctness/useJsxKeyInIterable: Astro does not use key prop on HTML tags
        <div class="swiper-slide">
          <div class="slide-container">
            {isYoutube(slide) ? (
              <div class="relative flex h-full w-full items-center justify-center bg-black">
                <iframe
                  src={getYoutubeEmbedUrl(slide, index === 0)}
                  class="h-full w-full object-contain"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                />
              </div>
            ) : isVideo(slide) ? (
              <div class="relative flex h-full w-full items-center justify-center bg-black">
                <video
                  src={slide}
                  class="gallery-video h-full w-full object-contain"
                  loop
                  muted
                  playsinline
                  preload={index === 0 ? "auto" : "metadata"}
                  autoplay={index === 0}
                />
                
                {/* Play button overlay */}
                <button class={`play-btn absolute z-20 flex size-16 items-center justify-center rounded-full bg-black/50 text-white hover:bg-black/70 ${index === 0 ? "is-playing" : ""}`} type="button" aria-label="Play">
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" class="translate-x-0.5">
                    <polygon points="6 3 20 12 6 21 6 3"/>
                  </svg>
                </button>

                {/* Mute/Unmute button bottom-right */}
                <button class="mute-btn absolute bottom-4 right-4 z-20 flex size-10 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80" type="button" aria-label="Mute/Unmute">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="volume-icon hidden">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
                  </svg>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mute-icon">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                    <line x1="22" x2="16" y1="9" y2="15"/>
                    <line x1="16" x2="22" y1="9" y2="15"/>
                  </svg>
                </button>
              </div>
            ) : (
              <img
                src={slide}
                alt={`${title} - ${index + 1}`}
                class="gallery-image"
                loading="lazy"
                width={360}
                height={640}
              />
            )}
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev" aria-label="Previous Slide"></div>
    <div class="swiper-button-next" aria-label="Next Slide"></div>
  </div>
</section>

<style>
  .gallery-section {
    padding: 4rem 1.5rem;
  }

  .slide-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background-color: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease;
  }

  .slide-container:hover {
    border-color: rgba(255, 141, 40, 0.4); /* Accent warm color */
    transform: translateY(-8px);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-color: #000;
  }

  .gallery-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-color: #000;
  }

  .play-btn {
    transition: all 0.2s ease;
  }

  .play-btn.is-playing {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
  }

  /* Swiper pagination styling overrides */
  :global(.gallerySwiper .swiper-pagination) {
    position: relative !important;
    bottom: 0 !important;
    margin-top: 2rem;
  }

  :global(.gallerySwiper .swiper-pagination-bullet) {
    width: 10px !important;
    height: 10px !important;
    background: transparent !important;
    border: 2px solid #000 !important;
    opacity: 0.6 !important;
    transition: all 0.3s ease !important;
  }

  :global(.gallerySwiper .swiper-pagination-bullet-active) {
    width: 24px !important;
    background: #000 !important;
    border-color: #000 !important;
    border-radius: 4px !important;
    opacity: 1 !important;
  }

  :global(.gallerySwiper .swiper-button-next),
  :global(.gallerySwiper .swiper-button-prev) {
    width: 44px !important;
    height: 44px !important;
    color: #ffff !important;
    background: rgba(0, 0, 0, 0.95) !important;
    border: 1px solid #000 !important;
    transition: all 0.3s ease !important;
    padding: 8px !important;
  }

  :global(.gallerySwiper .swiper-button-next::after),
  :global(.gallerySwiper .swiper-button-prev::after) {
    font-size: 18px !important;
    font-weight: bold !important;
  }

  :global(.gallerySwiper .swiper-button-next:hover),
  :global(.gallerySwiper .swiper-button-prev:hover) {
    color: #000 !important;
    background: #fff !important;
  }

  :global(.gallerySwiper .swiper-button-prev) {
    left: 10px !important;
  }

  :global(.gallerySwiper .swiper-button-next) {
    right: 10px !important;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination } from "swiper/modules";

  let gallerySwiper: Swiper | null = null;

  const setupVideos = () => {
    const videoContainers = document.querySelectorAll(
      ".gallerySwiper .swiper-slide"
    );

    for (const container of videoContainers) {
      const video = container.querySelector("video") as HTMLVideoElement | null;
      if (!video) {
        continue;
      }

      const playBtn = container.querySelector(
        ".play-btn"
      ) as HTMLButtonElement | null;
      const muteBtn = container.querySelector(
        ".mute-btn"
      ) as HTMLButtonElement | null;

      const togglePlay = () => {
        if (video.paused) {
          video.play().catch((err) => console.log("Playback failed:", err));
          playBtn?.classList.add("is-playing");
        } else {
          video.pause();
          playBtn?.classList.remove("is-playing");
        }
      };

      video.addEventListener("click", togglePlay);
      playBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        togglePlay();
      });

      muteBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        video.muted = !video.muted;

        const volumeIcon = muteBtn.querySelector(".volume-icon");
        const muteIcon = muteBtn.querySelector(".mute-icon");

        if (video.muted) {
          volumeIcon?.classList.add("hidden");
          muteIcon?.classList.remove("hidden");
        } else {
          volumeIcon?.classList.remove("hidden");
          muteIcon?.classList.add("hidden");
        }
      });

      // Keep playBtn state in sync
      video.addEventListener("pause", () => {
        playBtn?.classList.remove("is-playing");
      });
      video.addEventListener("play", () => {
        playBtn?.classList.add("is-playing");
      });

      // Initial check in case it's already playing or paused
      if (video.paused) {
        playBtn?.classList.remove("is-playing");
      } else {
        playBtn?.classList.add("is-playing");
      }
    }
  };

  const setupGallerySwiper = () => {
    if (gallerySwiper) {
      gallerySwiper.destroy(true, true);
    }

    gallerySwiper = new Swiper(".gallerySwiper", {
      modules: [Pagination, Navigation],
      slidesPerView: 1,
      spaceBetween: 16,
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      breakpoints: {
        425: {
          slidesPerView: 1,
          spaceBetween: 24,
        },
        640: {
          slidesPerView: 2,
          spaceBetween: 24,
        },
        1024: {
          slidesPerView: 3,
          spaceBetween: 30,
        },
        1280: {
          slidesPerView: 4,
          spaceBetween: 30,
        },
      },
    });

    setupVideos();
  };

  // Inicialización
  setupGallerySwiper();

  // Re-inicializar en navegación de Astro
  document.addEventListener("astro:after-swap", setupGallerySwiper);
</script>
