---
import { getCovers } from "@/services/cover.service";
import { getHero } from "@/services/hero.service";
import PrimaryButton from "../section-components/primaryButton.astro";

const covers = await getCovers();
const hero = await getHero();
---

<section class="w-full min-h-screen flex justify-center relative">
  <div class="w-full h-full absolute top-0">
    <div class="w-full h-full relative">
      <div class="w-full h-full bg-black">
        <img class="h-full xl:w-full object-cover" src={covers.home} alt="">
      </div>
      <div class="w-full h-full absolute top-0 bg-black/60"></div>
    </div>
  </div>
  <div class="w-full max-wrapper z-10 flex flex-col justify-end">
    <div class="w-full h-full flex justify-center items-center pt-20">
      <img
        id="hero-snake"
        class="w-20 object-cover transition-all duration-700 ease-out"
        src="/images/w-snake.png"
        alt=""
      >
    </div>
    <div class="w-full flex flex-col gap-8 pb-20">
      {hero.isPromo ? (
        <div class="promo-card w-full max-w-[520px] p-6 md:p-8 rounded-2xl flex flex-col gap-4 md:gap-5 border border-white/10 backdrop-blur-xl bg-black/40 shadow-2xl relative overflow-hidden">
          {hero.badge && (
            <span class="promo-badge self-start px-3 py-1 rounded-full text-xs font-semibold uppercase bg-website-orange text-black tracking-wider shadow-sm animate-pulse-subtle">
              {hero.badge}
            </span>
          )}
          <div class="flex flex-col gap-2">
            <h1 class="text-white text-3xl md:text-4xl font-mozilla font-extralight leading-snug tracking-wide uppercase">
              {hero.title}
            </h1>
            {hero.subtitle && (
              <p class="text-[#DADADA] text-sm md:text-base font-inter font-light leading-relaxed">
                {hero.subtitle}
              </p>
            )}
          </div>
          <div class="pt-2">
            <PrimaryButton href={hero.buttonUrl} label={hero.buttonLabel} />
          </div>
        </div>
      ) : (
        <>
          <h1
            class="w-full max-w-[480px] text-white text-3xl md:text-[40px] font-mozilla font-extralight md:text-base/10"
          >
            {hero.title}
          </h1>
          <PrimaryButton href={hero.buttonUrl} label={hero.buttonLabel} />
        </>
      )}
    </div>
  </div>
</section>

<style>
  .promo-card {
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.8);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease;
  }
  .promo-card:hover {
    border-color: rgba(255, 141, 40, 0.4);
    transform: translateY(-4px);
  }
  .animate-pulse-subtle {
    animation: pulse-subtle 3s infinite ease-in-out;
  }
  @keyframes pulse-subtle {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.03);
    }
  }
</style>
