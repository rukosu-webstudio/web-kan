---
import { getCovers } from "@/services/cover.service";
import PrimaryButton from "../section-components/primaryButton.astro";

const covers = await getCovers();
---

<section class="w-full min-h-screen flex justify-center relative">
  <div class="w-full h-full absolute top-0">
    <div class="w-full h-full relative">
      <div class="w-full h-full bg-black">
        <img class="h-full xl:w-full object-cover" src={covers.home} alt="" />
      </div>
      <div class="w-full h-full absolute top-0 bg-black/60"></div>
    </div>
  </div>
  <div class="w-full max-wrapper z-10 flex flex-col justify-end">
    <div class="w-full h-full flex justify-center items-center pt-20">
      <img
        id="hero-snake"
        class="w-20 object-cover transition-all duration-700 ease-out"
        src="/images/w-snake.png"
        alt=""
      />
    </div>
    <div class="w-full flex flex-col gap-8 pb-20">
      <h1
        class="w-full max-w-[480px] text-white text-3xl md:text-[40px] font-mozilla font-extralight md:text-base/10"
      >
        LA CONSTANCIA SUPERA LA MOTIVACIÓN
      </h1>
      <PrimaryButton href="/#collections" label="ver colección" />
    </div>
  </div>
</section>
