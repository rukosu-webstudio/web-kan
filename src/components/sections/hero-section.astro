---
import { getCovers } from "@/services/cover.service";
import { getHero } from "@/services/hero.service";
import PrimaryButton from "../section-components/primaryButton.astro";

const covers = await getCovers();
const hero = await getHero();
---

<section class="w-full min-h-screen flex justify-center relative">
  <div class="w-full h-full absolute top-0">
    <div class="w-full h-full relative">
      <div class="w-full h-full bg-black">
        <img class="h-full xl:w-full object-cover" src={covers.home} alt="">
      </div>
      <div class="w-full h-full absolute top-0 bg-black/60"></div>
    </div>
  </div>
  <div class="w-full max-wrapper z-10 flex flex-col justify-end">
    <div class="w-full h-full flex justify-center items-center pt-20">
      <img
        id="hero-snake"
        class="w-20 object-cover transition-all duration-700 ease-out"
        src="/images/w-snake.png"
        alt=""
      >
    </div>
    <div class="w-full flex flex-col gap-8 pb-20">
      {hero.isPromo && hero.content && (
        <div class="promo-banner w-full max-w-[480px] p-4 border border-white/10 backdrop-blur-xl bg-black/40 shadow-lg flex flex-col gap-2 relative">
          {hero.badge && (
            <span class="promo-badge self-start px-2 py-0.5 text-[10px] font-semibold uppercase bg-website-orange text-black tracking-wider animate-pulse-subtle">
              {hero.badge}
            </span>
          )}
          <div class="w-full max-w-full">
            <div
              class="markdawn-content w-full prose prose-neutral prose-invert max-w-none font-inter text-white text-sm md:text-base font-light leading-relaxed"
              set:html={hero.content}
            />
          </div>
        </div>
      )}

      <h1
        class="w-full max-w-[480px] text-white text-3xl md:text-[40px] font-mozilla font-extralight md:text-base/10 uppercase"
      >
        {hero.title}
      </h1>
      <PrimaryButton href="/#gallery" label="Nuestra galería" />
    </div>
  </div>
</section>

<style>
  .promo-banner {
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
    transition: border-color 0.3s ease;
  }
  .promo-banner:hover {
    border-color: rgba(255, 141, 40, 0.4);
  }
  .markdawn-content :global(p) {
    margin-bottom: 0.5rem;
  }
  .markdawn-content :global(p:last-child) {
    margin-bottom: 0;
  }
  .markdawn-content :global(a) {
    color: var(--color-website-orange);
    text-decoration: underline;
  }
  .markdawn-content :global(strong) {
    font-weight: 600;
  }
  .animate-pulse-subtle {
    animation: pulse-subtle 3s infinite ease-in-out;
  }
  @keyframes pulse-subtle {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.03);
    }
  }
</style>
