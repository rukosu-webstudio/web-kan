---
import { NAV_COLLECTIONS, NAV_ROUTES, ROUTE } from "@/config/routes";
import { cls11 } from "@/lib/utils";
---

<header
  class="w-full fixed top-0 z-40 transition-all duration-300 ease-in-out"
  id="main-header"
>
  <nav
    class="w-full flex justify-center pt-10 pb-2 transition-all duration-300 ease-in-out"
    id="main-nav"
  >
    <div
      class="w-full max-wrapper flex justify-between items-center text-xl text-white uppercase font-light gap-10"
    >
      <div class="w-fit flex items-center gap-12 basis-0">
        {
          NAV_COLLECTIONS.map((route) => (
            <a class="" href={route.path}>
              {route.title}
            </a>
          ))
        }
      </div>
      <div class="w-full flex justify-center items-center relative h-16">
        <img
          id="logo-kan"
          class="h-16 w-auto object-cover transition-all duration-500 ease-in-out"
          src="/images/w-kan.png"
          alt=""
        />
        <img
          id="logo-main"
          class="h-16 w-auto object-cover transition-all duration-500 ease-in-out logoHeaderAnimation"
          src="/images/w-snake.png"
          alt=""
        />
      </div>

      <div class="w-fit flex items-center gap-12 basis-0">
        <a class="text-website-orange" href=""> {ROUTE.SHOP.title} </a>
        {
          NAV_ROUTES.map((route) => (
            <a class="" href={route.path}>
              {route.title}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("main-header");
  const nav = document.getElementById("main-nav");
  const logoKan = document.getElementById("logo-kan");
  const logoMain = document.getElementById("logo-main");
  const heroSnake = document.getElementById("hero-snake");

  const handleScroll = () => {
    const isScrolled = window.scrollY > 50;

    if (isScrolled) {
      header?.classList.add("bg-black/90", "backdrop-blur-sm");
      nav?.classList.remove("pt-10");
      nav?.classList.add("pt-4");

      // Swap Logos
      logoKan?.classList.add("logoHeaderAnimation");
      logoMain?.classList.remove("logoHeaderAnimation");

      // Snake Animation
      heroSnake?.classList.add("opacity-0", "-translate-y-20");
    } else {
      header?.classList.remove("bg-black/90", "backdrop-blur-sm");
      nav?.classList.add("pt-10");
      nav?.classList.remove("pt-4");

      // Reverse Logos
      logoKan?.classList.remove("logoHeaderAnimation");
      logoMain?.classList.add("logoHeaderAnimation");

      // Reverse Snake
      heroSnake?.classList.remove("opacity-0", "-translate-y-20");
    }
  };

  window.addEventListener("scroll", handleScroll);
  // Check on initial load
  handleScroll();
</script>
