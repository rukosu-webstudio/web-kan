---

---

<form id="contact-form" class="w-full flex flex-col justify-center items-center gap-2.5">
  <div class="w-full flex max-lg:flex-col gap-2.5">
    <label class="w-full px-4 py-2.5 flex border border-black" for="name">
      <input
        class="w-full text-black font-mozilla uppercase placeholder:text-website-secondary/50 outline-none"
        id="name"
        placeholder="Nombre"
        type="text"
        name="name"
        autocomplete="name"
        required
      />
    </label>
    <label class="w-full px-4 py-2.5 flex border border-black" for="phone">
      <input
        class="w-full text-black font-mozilla uppercase placeholder:text-website-secondary/50 outline-none"
        id="phone"
        placeholder="Teléfono"
        type="tel"
        name="phone"
        autocomplete="tel"
        required
      />
    </label>
  </div>
  <label class="w-full px-4 py-2.5 flex border border-black" for="email">
    <input
      class="w-full text-black font-mozilla uppercase placeholder:text-website-secondary/50 outline-none"
      id="email"
      placeholder="Correo electrónico"
      type="text"
      name="email"
      autocomplete="email"
      required
    />
  </label>
  <label class="w-full px-4 py-2.5 flex border border-black" for="message">
    <textarea
      class="w-full outline-none text-black font-mozilla uppercase placeholder:text-website-secondary/50 h-32"
      id="message"
      placeholder="Mensaje"
      name="message"></textarea>
  </label>
  <button
    id="submit"
    type="submit"
    class="w-fit px-14 lg:px-20 py-2 bg-black text-white lg:text-xl uppercase button-hover"
  >
    enviar
  </button>
</form>

<script src="../../scripts/contact-form.ts"></script>
