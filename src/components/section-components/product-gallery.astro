---
import "swiper/css";
import "swiper/css/navigation";
import "swiper/css/pagination";
import "glightbox/dist/css/glightbox.min.css";

interface Props {
  cover: string;
  gallery?: string[];
  name: string;
}

const { cover, gallery = [], name } = Astro.props;
const allImages = [cover, ...gallery].map((url) => ({
  url,
  alt: name,
}));
---

<style>
  .swiper {
    width: 100%;
    margin: 0 auto;
  }

  .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    text-align: center;
    background: #fff;
  }

  .swiper-slide-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mySwiper2 {
    width: 100%;
    max-width: 550px;
    aspect-ratio: 1 / 1;
  }

  .mySwiper {
    box-sizing: border-box;
    width: 100%;
    max-width: 600px;
    height: auto;
    padding: 10px 0;
  }

  /* Ajustes para miniaturas verticales en MD */
  @media (min-width: 768px) {
    .mySwiper {
      max-width: 120px;
      height: 550px; /* Misma altura que el slider principal */
      padding: 0;
      margin: 0;
    }
  }

  .mySwiper .swiper-slide {
    width: 25%;
    max-width: 120px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 2px solid transparent;
    opacity: 0.7;
  }

  @media (min-width: 768px) {
    .mySwiper .swiper-slide {
      width: 100%;
    }
  }

  .mySwiper .swiper-slide-thumb-active {
    border-color: #ff8d28;
    opacity: 1;
  }

  .swiper-button-next,
  .swiper-button-prev {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px !important;
    height: 44px !important;
    padding: 10px;
    color: #fff !important;
    background-color: #0000006b;
    border-radius: 50%;
  }

  .swiper-button-next:after,
  .swiper-button-prev:after {
    font-size: 18px !important;
    font-weight: bold;
  }

  .swiper-slide-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  img {
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    -webkit-user-drag: none;
  }
</style>

<section
  class="w-full max-w-full flex flex-col md:flex-row gap-4 overflow-hidden items-center md:items-start"
>
  <!-- Miniaturas Swiper (A la izquierda en MD) -->
  <div class="md:w-[120px] w-full min-w-0 order-2 md:order-1">
    <div thumbsSlider="" class="swiper mySwiper relative w-full">
      <div class="swiper-wrapper cursor-grab">
        {allImages.map((img) => (
            // biome-ignore lint/correctness/useJsxKeyInIterable: Astro doesn't use key prop on HTML tags
            <div class="swiper-slide cursor-pointer bg-white border border-transparent">
              <img
                loading="lazy"
                class="swiper-slide-img select-none"
                src={img.url}
                alt={img.alt}
                width={120}
                height={120}
              />
            </div>
          ))}
      </div>
    </div>
  </div>

  <!-- Contenedor Principal (A la derecha en MD) -->
  <div
    class="swiper mySwiper2 relative overflow-hidden bg-white border border-transparent min-w-0 order-1 md:order-2"
  >
    <div class="swiper-wrapper">
      {allImages.map((img) => (
          // biome-ignore lint/correctness/useJsxKeyInIterable: Astro doesn't use key prop on HTML tags
          <div class="swiper-slide">
            <a
              href={img.url}
              class="glightbox w-full h-full flex justify-center items-center"
            >
              <img
                loading="lazy"
                class="swiper-slide-cover select-none"
                src={img.url}
                alt={img.alt}
                width={550}
                height={550}
              />
            </a>
          </div>
        ))}
    </div>

    <div
      class="swiper-button-next absolute top-1/2 right-4 transform -translate-y-1/2 btnHover"
    ></div>
    <div
      class="swiper-button-prev absolute top-1/2 left-4 transform -translate-y-1/2 btnHover"
    ></div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { FreeMode, Navigation, Pagination, Thumbs } from "swiper/modules";

  let mainSwiper: Swiper | null = null;
  let thumbSwiper: Swiper | null = null;

  const setupSwiper = () => {
    // Limpieza de instancias previas
    if (mainSwiper) {
      mainSwiper.destroy(true, true);
    }
    if (thumbSwiper) {
      thumbSwiper.destroy(true, true);
    }

    const isDesktop = window.innerWidth >= 768;

    thumbSwiper = new Swiper(".mySwiper", {
      modules: [FreeMode, Thumbs, Navigation],
      direction: isDesktop ? "vertical" : "horizontal",
      loop: true,
      spaceBetween: 10,
      slidesPerView: isDesktop ? 5 : 4,
      freeMode: true,
      watchSlidesProgress: true,
    });

    mainSwiper = new Swiper(".mySwiper2", {
      loop: true,
      spaceBetween: 10,
      modules: [Navigation, Pagination, Thumbs],
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      thumbs: { swiper: thumbSwiper },
    });
  };

  // Inicialización
  setupSwiper();

  // Re-inicializar en cambios de tamaño para asegurar la dirección correcta
  window.addEventListener("resize", () => {
    const isDesktop = window.innerWidth >= 768;
    const currentDirection = thumbSwiper?.params.direction;

    if (
      (isDesktop && currentDirection !== "vertical") ||
      (!isDesktop && currentDirection !== "horizontal")
    ) {
      setupSwiper();
    }
  });

  document.addEventListener("astro:after-swap", setupSwiper);
</script>

<script>
  import GLightbox from "glightbox";

  const setupLightbox = () => {
    GLightbox({
      selector: ".glightbox",
      touchNavigation: true,
      loop: true,
      zoomable: true,
    });
    const buttons = document.querySelectorAll(
      ".swiper-button-next, .swiper-button-prev"
    );
    for (const btn of buttons) {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
      });
    }
  };

  setupLightbox();
  document.addEventListener("astro:after-swap", setupLightbox);
</script>
